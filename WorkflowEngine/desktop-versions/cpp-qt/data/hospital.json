  {
   "id": "appointments",
   "kind": "appointment",
   "en": "Appointments",
   "ar": "المواعيد",
   "perm": [
    "hos.appointments.view"
   ],
   "day": true,
   "take": 500,
   "columns": [
    {
     "p": "data.start",
     "en": "Start",
     "ar": "الموعد"
    },
    {
     "p": "data.patientName",
     "en": "Patient",
     "ar": "المريض"
    },
    {
     "p": "data.doctorName",
     "en": "Doctor",
     "ar": "الطبيب"
    },
    {
     "p": "data.reason",
     "en": "Reason",
     "ar": "السبب"
    },
    {
     "p": "status",
     "en": "Status",
     "ar": "الحالة"
    }
   ],
   "create": {
    "en": "Book",
    "ar": "حجز موعد",
    "post": "appointments",
    "fields": [
     {
      "k": "patient",
      "en": "Patient",
      "ar": "المريض",
      "t": "select",
      "req": true,
      "src": {
       "kind": "patient",
       "v": "code",
       "l": "data.name",
       "take": 300
      }
     },
     {
      "k": "doctor",
      "en": "Doctor",
      "ar": "الطبيب",
      "t": "select",
      "req": true,
      "src": {
       "kind": "doctor",
       "v": "code",
       "l": "data.name"
      }
     },
     {
      "k": "date",
      "en": "Date",
      "ar": "التاريخ",
      "t": "date",
      "req": true,
      "def": "$today",
      "join": "start"
     },
     {
      "k": "time",
      "en": "Time",
      "ar": "الوقت",
      "t": "time",
      "req": true,
      "def": "09:00",
      "join": "start"
     },
     {
      "k": "minutes",
      "en": "Minutes",
      "ar": "المدة (دقيقة)",
      "t": "num",
      "def": "20"
     },
     {
      "k": "reason",
      "en": "Reason",
      "ar": "السبب"
     }
    ]
   },
   "actions": [
    {
     "id": "in",
     "en": "Check in",
     "ar": "تسجيل الحضور",
     "when": [
      "Booked"
     ],
     "post": "appointments/{id}/status",
     "body": {
      "status": "CheckedIn",
      "today": "$today"
     },
     "fields": []
    },
    {
     "id": "done",
     "en": "Complete",
     "ar": "إنهاء",
     "when": [
      "CheckedIn"
     ],
     "post": "appointments/{id}/status",
     "body": {
      "status": "Completed",
      "today": "$today"
     },
     "fields": []
    },
    {
     "id": "cancel",
     "en": "Cancel",
     "ar": "إلغاء",
     "when": [
      "Booked",
      "CheckedIn"
     ],
     "post": "appointments/{id}/status",
     "body": {
      "status": "Cancelled",
      "today": "$today"
     },
     "fields": [],
     "confirm": true
    }
   ]
  },
